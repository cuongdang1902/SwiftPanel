<Window x:Class="SwiftPanel.Views.MultiRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-Rename" Height="580" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="460" MinWidth="600"
        Background="#F0EEE8"
        FontFamily="Segoe UI" FontSize="11"
        KeyDown="OnKeyDown">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Pattern controls -->
            <RowDefinition Height="Auto"/>  <!-- Counter controls -->
            <RowDefinition Height="Auto"/>  <!-- Case / strip options -->
            <RowDefinition Height="Auto"/>  <!-- Token cheat-sheet -->
            <RowDefinition Height="*"/>     <!-- Preview list -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ── PATTERN ── -->
        <GroupBox Grid.Row="0" Header=" Rename Pattern " Margin="0,0,0,6"
                  BorderBrush="#A0A0A0" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name pattern:" Margin="0,0,8,4" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NamePatternBox"
                           Text="[N]" Margin="0,0,0,4" Padding="3,2"
                           TextChanged="OnPatternChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ext pattern:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ExtPatternBox"
                           Text="[E]" Padding="3,2"
                           TextChanged="OnPatternChanged"/>
            </Grid>
        </GroupBox>

        <!-- ── COUNTER ── -->
        <GroupBox Grid.Row="1" Header=" Counter  [C] " Margin="0,0,0,6"
                  BorderBrush="#A0A0A0" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="CounterStartBox" Text="1" Width="50" Padding="3,2"
                         TextChanged="OnPatternChanged"/>
                <TextBlock Text="Step:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="CounterStepBox" Text="1" Width="50" Padding="3,2"
                         TextChanged="OnPatternChanged"/>
                <TextBlock Text="Digits:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="CounterDigitsBox" Text="2" Width="50" Padding="3,2"
                         TextChanged="OnPatternChanged"/>
                <TextBlock Text="(e.g. 01, 02…)" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
            </StackPanel>
        </GroupBox>

        <!-- ── CASE / STRIP ── -->
        <GroupBox Grid.Row="2" Header=" Options " Margin="0,0,0,6"
                  BorderBrush="#A0A0A0" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Case:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="CaseNone"  Content="Keep"  GroupName="Case" IsChecked="True"
                             Margin="0,0,10,0" Checked="OnPatternChanged"/>
                <RadioButton x:Name="CaseLower" Content="lower" GroupName="Case"
                             Margin="0,0,10,0" Checked="OnPatternChanged"/>
                <RadioButton x:Name="CaseUpper" Content="UPPER" GroupName="Case"
                             Margin="0,0,10,0" Checked="OnPatternChanged"/>
                <RadioButton x:Name="CaseTitle" Content="Title" GroupName="Case"
                             Margin="0,0,20,0" Checked="OnPatternChanged"/>

                <CheckBox x:Name="RemoveSpacesBox" Content="Replace spaces with _"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="OnPatternChanged" Unchecked="OnPatternChanged"/>
            </StackPanel>
        </GroupBox>

        <!-- ── TOKEN CHEATSHEET ── -->
        <Border Grid.Row="3" Background="#FFFFF0" BorderBrush="#C8C000"
                BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,0,6">
            <TextBlock FontSize="10" Foreground="#606000" TextWrapping="Wrap">
                <Run FontWeight="Bold">[N]</Run><Run> = original name   </Run>
                <Run FontWeight="Bold">[N1-3]</Run><Run> = chars 1–3 of name   </Run>
                <Run FontWeight="Bold">[E]</Run><Run> = extension (no dot)   </Run>
                <Run FontWeight="Bold">[C]</Run><Run> = counter   </Run>
                <Run FontWeight="Bold">[D]</Run><Run> = date (yyyyMMdd)   </Run>
                <Run FontWeight="Bold">[T]</Run><Run> = time (HHmmss)   </Run>
                <Run FontWeight="Bold">[Y]</Run><Run>/</Run>
                <Run FontWeight="Bold">[M]</Run><Run>/</Run>
                <Run FontWeight="Bold">[d]</Run><Run> = year/month/day individually</Run>
            </TextBlock>
        </Border>

        <!-- ── PREVIEW LIST ── -->
        <GroupBox Grid.Row="4" Header=" Preview " Margin="0,0,0,6"
                  BorderBrush="#A0A0A0">
            <ListView x:Name="PreviewList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Original Name"  Width="320" DisplayMemberBinding="{Binding OldName}"/>
                        <GridViewColumn Header="New Name"       Width="380" DisplayMemberBinding="{Binding NewName}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FontSize" Value="10"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </GroupBox>

        <!-- ── BUTTONS ── -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText" Grid.Column="0"
                       VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>

            <Button Grid.Column="1" Content="Rename" x:Name="RenameButton"
                    Width="90" Margin="4,0,0,0" Padding="0,4"
                    IsDefault="True" Click="OnRenameClick"/>
            <Button Grid.Column="2" Content="Cancel"
                    Width="90" Margin="4,0,0,0" Padding="0,4"
                    IsCancel="True" Click="OnCancelClick"/>
        </Grid>
    </Grid>
</Window>
