<Window x:Class="SwiftPanel.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operation in Progress"
        Width="480" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0EEE8"
        FontFamily="Segoe UI" FontSize="11">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Operation label -->
        <TextBlock Grid.Row="0" x:Name="OperationLabel"
                   Text="Copying files..." FontWeight="Bold"/>

        <!-- Current file -->
        <TextBlock Grid.Row="2" x:Name="CurrentFileLabel"
                   Text="" Foreground="#404040"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="4" x:Name="ProgressBar"
                     Height="18" Minimum="0" Maximum="100" Value="0"
                     Foreground="#316AC5"/>

        <!-- Cancel button -->
        <Button Grid.Row="6" x:Name="CancelButton"
                Content="Cancel" Width="80" HorizontalAlignment="Right"
                Click="OnCancel" IsCancel="True"
                Padding="8,3"/>
    </Grid>
</Window>
