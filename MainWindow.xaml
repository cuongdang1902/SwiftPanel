<Window x:Class="SwiftPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SwiftPanel.Controls"
        xmlns:vm="clr-namespace:SwiftPanel.ViewModels"
        Title="SwiftPanel - Agentic Workspace" Height="650" Width="1100"
        MinHeight="400" MinWidth="700"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="11"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Logo.png"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- Menu + Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="38"/>   <!-- Status bar (2 rows) -->
        </Grid.RowDefinitions>

        <!-- ===== MENU + TOOLBAR ===== -->
        <Grid Grid.Row="0" Background="{StaticResource ToolbarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar buttons -->
            <Border Grid.Row="0" BorderBrush="{StaticResource ColumnHeaderBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <!-- Navigation history: circular arrow icons -->
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Padding="2" Margin="1,2"
                            ToolTip="Back (Alt+←)"
                            Command="{Binding ActivePanel.NavigateBackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24" Margin="0,-3,4,3" VerticalAlignment="Center">
                                <!-- Blue left arrow -->
                                <Path Fill="{StaticResource SplitterBrush}"
                                      Data="M 17,9 L 9,15 L 17,21 L 17,18 L 23,18 L 23,12 L 17,12 Z"/>
                            </Viewbox>
                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Padding="2" Margin="1,2"
                            ToolTip="Forward (Alt+→)"
                            Command="{Binding ActivePanel.NavigateForwardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24" Margin="0,-3,4,3" VerticalAlignment="Center">
                                <!-- Blue right arrow -->
                                <Path Fill="{StaticResource SplitterBrush}"
                                      Data="M 15,9 L 23,15 L 15,21 L 15,18 L 9,18 L 9,12 L 15,12 Z"/>
                            </Viewbox>
                            <TextBlock Text="Forward" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="3,4"/>
                    <Button Content="📁 New Folder" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding NewFolderCommand}" ToolTip="New Folder (F7)"/>
                    <Separator Margin="3,4"/>
                    <Button Content="📋 Copy" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CopyCommand}" ToolTip="Copy (F5)"/>
                    <Button Content="✂️ Move" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding MoveCommand}" ToolTip="Move (F6)"/>
                    <Button Content="🗑️ Delete" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding DeleteCommand}" ToolTip="Delete (F8)"/>
                    <Button Content="✏️ Rename" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding RenameCommand}" ToolTip="Rename (F2)"/>
                    <Button Content="🔤 Multi-Rename" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding MultiRenameCommand}" ToolTip="Multi-Rename (Ctrl+M)"/>
                    <Separator Margin="3,4"/>
                    <Button Content="🔍 Find" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding FindCommand}" ToolTip="Find (Alt+F7)"/>
                    <Separator Margin="3,4"/>
                    <Button Content="☑ Mark All" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding MarkAllCommand}" ToolTip="Mark All (Num+)"/>
                    <Button Content="☐ Unmark" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding UnmarkAllCommand}" ToolTip="Unmark All (Num-)"/>
                    <Button Content="⇄ Invert" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding InvertMarksCommand}" ToolTip="Invert Marks (Num*)"/>
                    <Separator Margin="3,4"/>
                    <!-- Bookmarks button + popup -->
                    <Button x:Name="BookmarksBtn" Content="★ Bookmarks"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Bookmarks (Ctrl+D to add)"
                            Click="OnBookmarksBtnClick">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="BookmarksMenu" StaysOpen="False">
                                <MenuItem Header="★ Add current folder  Ctrl+D"
                                          Command="{Binding AddBookmarkCommand}"
                                          FontWeight="Bold"/>
                                <Separator/>
                                <MenuItem Header="(no bookmarks yet)" IsEnabled="False"
                                          x:Name="NoBookmarksItem"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Separator Margin="3,4"/>
                    <Button Content="▓ Terminal" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenTerminalCommand}" ToolTip="Open Terminal (Ctrl+T)"/>
                    <Separator Margin="3,4"/>
                    <Button Content="👁️ Viewer" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ToggleViewerCommand}" ToolTip="Quick Viewer (F3)"/>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ===== MAIN CONTENT: Two Panels + Splitter + Viewer ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="0"  x:Name="ViewerSplitterCol"/>
                <ColumnDefinition Width="0"  x:Name="ViewerCol" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <controls:FilePanel Grid.Column="0"
                                x:Name="LeftPanelControl"
                                Tag="Left"
                                DataContext="{Binding LeftPanel}"
                                IsActive="{Binding IsLeftActive}"
                                MainViewModel="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource SplitterBrush}"
                          Cursor="SizeWE"
                          ShowsPreview="True"/>

            <!-- RIGHT PANEL -->
            <controls:FilePanel Grid.Column="2"
                                x:Name="RightPanelControl"
                                Tag="Right"
                                DataContext="{Binding RightPanel}"
                                IsActive="{Binding IsRightActive}"
                                MainViewModel="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- VIEWER SPLITTER (hidden until F3) -->
            <GridSplitter Grid.Column="3" x:Name="ViewerSplitter"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#404040"
                          Cursor="SizeWE"
                          ShowsPreview="True"
                          Visibility="Collapsed"/>

            <!-- F3 QUICK VIEWER PANEL -->
            <controls:FileViewerPanel Grid.Column="4" x:Name="ViewerPanelControl"
                                      DataContext="{Binding Viewer}"
                                      Visibility="Collapsed"/>
        </Grid>

        <!-- ===== STATUS BAR (2 rows: file info + disk usage) ===== -->
        <Border Grid.Row="2" Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource ColumnHeaderBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="4,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left: file count status -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding LeftPanel.StatusText}"
                           VerticalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Left: disk usage bar -->
                <Grid Grid.Column="0" Grid.Row="1" Height="8" Margin="0,1,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{Binding LeftPanel.DriveUsedPercent, Mode=OneWay}"
                                 Maximum="100" Height="6" VerticalAlignment="Center"
                                 Background="#D0D0D0" BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="{StaticResource SplitterBrush}"/>
                                <Style.Triggers>
                                    <!-- Blue when >75% used (changed from orange) -->
                                    <DataTrigger Binding="{Binding LeftPanel.DriveUsedPercent,
                                        Converter={StaticResource ThresholdToBoolConverter},
                                        ConverterParameter=75}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SplitterBrush}"/>
                                    </DataTrigger>
                                    <!-- Red when >90% used -->
                                    <DataTrigger Binding="{Binding LeftPanel.DriveUsedPercent,
                                        Converter={StaticResource ThresholdToBoolConverter},
                                        ConverterParameter=90}" Value="True">
                                        <Setter Property="Foreground" Value="#E53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Grid.Column="1" Text="{Binding LeftPanel.DriveSpaceText}"
                               FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Right: file count status -->
                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding RightPanel.StatusText}"
                           VerticalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Right: disk usage bar -->
                <Grid Grid.Column="2" Grid.Row="1" Height="8" Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{Binding RightPanel.DriveUsedPercent, Mode=OneWay}"
                                 Maximum="100" Height="6" VerticalAlignment="Center"
                                 Background="#D0D0D0" BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="{StaticResource SplitterBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RightPanel.DriveUsedPercent,
                                        Converter={StaticResource ThresholdToBoolConverter},
                                        ConverterParameter=75}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SplitterBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RightPanel.DriveUsedPercent,
                                        Converter={StaticResource ThresholdToBoolConverter},
                                        ConverterParameter=90}" Value="True">
                                        <Setter Property="Foreground" Value="#E53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Grid.Column="1" Text="{Binding RightPanel.DriveSpaceText}"
                               FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
