<Window x:Class="SwiftPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SwiftPanel.Controls"
        xmlns:vm="clr-namespace:SwiftPanel.ViewModels"
        Title="SwiftPanel" Height="650" Width="1100"
        MinHeight="400" MinWidth="700"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="11"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- Menu + Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="38"/>   <!-- Status bar (2 rows) -->
        </Grid.RowDefinitions>

        <!-- ===== MENU + TOOLBAR ===== -->
        <Grid Grid.Row="0" Background="{StaticResource ToolbarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar buttons -->
            <Border Grid.Row="0" BorderBrush="{StaticResource ColumnHeaderBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <!-- Navigation history -->
                    <Button Content="◀" FontSize="10" Padding="5,2" Margin="1,2"
                            ToolTip="Back (Alt+←)"
                            Command="{Binding ActivePanel.NavigateBackCommand}"/>
                    <Button Content="►" FontSize="10" Padding="5,2" Margin="1,2"
                            ToolTip="Forward (Alt+→)"
                            Command="{Binding ActivePanel.NavigateForwardCommand}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,4"/>
                    <Button Content="📁 New Folder" Command="{Binding NewFolderCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="New Folder (F7)"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,4"/>
                    <Button Content="📋 Copy" Command="{Binding CopyCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Copy (F5)"/>
                    <Button Content="✂️ Move" Command="{Binding MoveCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Move (F6)"/>
                    <Button Content="🗑️ Delete" Command="{Binding DeleteCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Delete (F8)"/>
                    <Button Content="✏️ Rename" Command="{Binding RenameCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Rename (F2)"/>
                    <Button Content="🔤 Multi-Rename" Command="{Binding MultiRenameCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Multi-Rename (Ctrl+M)"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,4"/>
                    <Button Content="🔍 Find" Command="{Binding FindCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Find (Ctrl+F)"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,4"/>
                    <Button Content="☑ Mark All" Command="{Binding MarkAllCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Mark All (Num+)"/>
                    <Button Content="☐ Unmark" Command="{Binding UnmarkAllCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Unmark All (Num-)"/>
                    <Button Content="⇄ Invert" Command="{Binding InvertMarksCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Invert Marks (Num*)"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,4"/>
                    <!-- Bookmarks button + popup -->
                    <Button x:Name="BookmarksBtn" Content="★ Bookmarks"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Bookmarks (Ctrl+D to add)"
                            Click="OnBookmarksBtnClick">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="BookmarksMenu" StaysOpen="False">
                                <MenuItem Header="★ Add current folder  Ctrl+D"
                                          Command="{Binding AddBookmarkCommand}"
                                          FontWeight="Bold"/>
                                <Separator/>
                                <MenuItem Header="(no bookmarks yet)" IsEnabled="False"
                                          x:Name="NoBookmarksItem"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,4"/>
                    <Button Content="⬛ Terminal" Command="{Binding OpenTerminalCommand}"
                            Padding="6,2" Margin="1,2" FontSize="10" ToolTip="Open Terminal (Ctrl+T)"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== MAIN CONTENT: Two Panels + Splitter + Viewer ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="0"  x:Name="ViewerSplitterCol"/>
                <ColumnDefinition Width="0"  x:Name="ViewerCol" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <controls:FilePanel Grid.Column="0"
                                x:Name="LeftPanelControl"
                                Tag="Left"
                                DataContext="{Binding LeftPanel}"
                                IsActive="{Binding IsLeftActive}"
                                MainViewModel="{Binding}"/>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource SplitterBrush}"
                          Cursor="SizeWE"
                          ShowsPreview="True"/>

            <!-- RIGHT PANEL -->
            <controls:FilePanel Grid.Column="2"
                                x:Name="RightPanelControl"
                                Tag="Right"
                                DataContext="{Binding RightPanel}"
                                IsActive="{Binding IsRightActive}"
                                MainViewModel="{Binding}"/>

            <!-- VIEWER SPLITTER (hidden until F3) -->
            <GridSplitter Grid.Column="3" x:Name="ViewerSplitter"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#404040"
                          Cursor="SizeWE"
                          ShowsPreview="True"
                          Visibility="Collapsed"/>

            <!-- F3 QUICK VIEWER PANEL -->
            <controls:FileViewerPanel Grid.Column="4" x:Name="ViewerPanelControl"
                                      DataContext="{Binding Viewer}"
                                      Visibility="Collapsed"/>
        </Grid>

        <!-- ===== STATUS BAR (2 rows: file info + disk usage) ===== -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBackgroundBrush}"
                BorderBrush="{StaticResource ColumnHeaderBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="4,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left: file count status -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding LeftPanel.StatusText}"
                           VerticalAlignment="Center" FontSize="10"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Left: disk usage bar -->
                <Grid Grid.Column="0" Grid.Row="1" Height="8" Margin="0,1,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{Binding LeftPanel.DriveUsedPercent, Mode=OneWay}"
                                 Maximum="100" Height="6" VerticalAlignment="Center"
                                 Foreground="#4CAF50" Background="#D0D0D0" BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LeftPanel.DriveUsedPercent, Converter={StaticResource BoolToVisibilityConverter}}" Value="Visible">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Grid.Column="1" Text="{Binding LeftPanel.DriveSpaceText}"
                               FontSize="9" Foreground="Gray" Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Right: file count status -->
                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding RightPanel.StatusText}"
                           VerticalAlignment="Center" FontSize="10"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Right: disk usage bar -->
                <Grid Grid.Column="2" Grid.Row="1" Height="8" Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{Binding RightPanel.DriveUsedPercent, Mode=OneWay}"
                                 Maximum="100" Height="6" VerticalAlignment="Center"
                                 Foreground="#4CAF50" Background="#D0D0D0" BorderThickness="0"/>
                    <TextBlock Grid.Column="1" Text="{Binding RightPanel.DriveSpaceText}"
                               FontSize="9" Foreground="Gray" Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
