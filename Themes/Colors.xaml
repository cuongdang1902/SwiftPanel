<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== SpeedCommander 13 – Classic Blue Theme ===== -->
    <!-- Inspired by SC13 "Office 2013 Blue" default look  -->

    <!-- App / window chrome -->
    <SolidColorBrush x:Key="AppBackgroundBrush"       Color="#C8C8C8"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush"   Color="#E8ECEF"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#E8ECEF"/>

    <!-- Splitter -->
    <SolidColorBrush x:Key="SplitterBrush"      Color="#007ACC"/>
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#1C97EA"/>

    <!-- Drive bar -->
    <SolidColorBrush x:Key="DriveBarBackgroundBrush"  Color="#E8ECEF"/>
    <SolidColorBrush x:Key="DriveButtonBrush"         Color="#DCDFE2"/>
    <SolidColorBrush x:Key="DriveButtonHoverBrush"    Color="#C7E3F7"/>
    <SolidColorBrush x:Key="DriveButtonBorderBrush"   Color="#AEAFB2"/>

    <!-- Path / Breadcrumb bar -->
    <SolidColorBrush x:Key="PathBarBackgroundBrush"       Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PathBarBorderBrush"           Color="#CCCEDB"/>
    <SolidColorBrush x:Key="BreadcrumbForegroundBrush"    Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BreadcrumbLastSegmentBrush"   Color="#007ACC"/>
    <SolidColorBrush x:Key="BreadcrumbSeparatorBrush"     Color="#8A8A8A"/>

    <!-- Column headers -->
    <SolidColorBrush x:Key="ColumnHeaderBackgroundBrush"  Color="#E8ECEF"/>
    <SolidColorBrush x:Key="ColumnHeaderBorderBrush"      Color="#CCCEDB"/>
    <SolidColorBrush x:Key="ColumnHeaderForegroundBrush"  Color="#1E1E1E"/>

    <!-- File list -->
    <SolidColorBrush x:Key="FileListBackgroundBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FileListAlternateRowBrush"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FileListBorderBrush"         Color="#CCCEDB"/>

    <!-- Selection: active panel (SC13 blue) -->
    <SolidColorBrush x:Key="SelectionActiveBrush"        Color="#007ACC"/>
    <SolidColorBrush x:Key="SelectionActiveTextBrush"    Color="#FFFFFF"/>
    <!-- Selection: inactive panel (muted blue-gray) -->
    <SolidColorBrush x:Key="SelectionInactiveBrush"      Color="#BCD6E8"/>
    <SolidColorBrush x:Key="SelectionInactiveTextBrush"  Color="#1E1E1E"/>
    <!-- Hover -->
    <SolidColorBrush x:Key="ListHoverBrush"              Color="#E5F3FB"/>

    <!-- Tab bar -->
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#E8ECEF"/>
    <SolidColorBrush x:Key="TabActiveBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabInactiveBrush"      Color="#D5D9DC"/>
    <SolidColorBrush x:Key="TabHoverBrush"         Color="#EBF4FB"/>
    <SolidColorBrush x:Key="TabBorderBrush"        Color="#CCCEDB"/>
    <SolidColorBrush x:Key="TabCloseHoverBrush"    Color="#E81123"/>

    <!-- Active panel accent (SC13: blue top border) -->
    <SolidColorBrush x:Key="ActivePanelBorderBrush"   Color="#007ACC"/>
    <SolidColorBrush x:Key="InactivePanelBorderBrush" Color="Transparent"/>

    <!-- Text colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush"   Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#444444"/>
    <!-- SC13: folders = black -->
    <SolidColorBrush x:Key="FolderTextBrush"    Color="#1E1E1E"/>

    <!-- Toolbar -->
    <SolidColorBrush x:Key="ToolbarButtonHoverBrush"   Color="#C7E3F7"/>
    <SolidColorBrush x:Key="ToolbarButtonPressedBrush" Color="#9DC9E5"/>
    <SolidColorBrush x:Key="ToolbarButtonBorderBrush"  Color="#7BB3CC"/>

    <!-- Filter bar (SC13: light blue tint) -->
    <SolidColorBrush x:Key="FilterBarBackgroundBrush"  Color="#EBF4FB"/>
    <SolidColorBrush x:Key="FilterBarBorderBrush"      Color="#007ACC"/>
    <SolidColorBrush x:Key="FilterBarLabelBrush"       Color="#005A9E"/>

    <!-- Status bar text: dark on light gray background -->
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#1E1E1E"/>

    <!-- Font sizes -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="SmallFontSize">11</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="NormalFontSize">13</system:Double>

    <!-- ===== Toolbar Button Style ===== -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="BorderBrush"       Value="Transparent"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Padding"           Value="6,3"/>
        <Setter Property="FontSize"          Value="15"/>
        <Setter Property="Margin"            Value="1,2"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"   Value="#C7E3F7"/>
                            <Setter TargetName="Bd" Property="BorderBrush"  Value="#007ACC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"   Value="#9DC9E5"/>
                            <Setter TargetName="Bd" Property="BorderBrush"  Value="#005A9E"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Column Header Button Style ===== -->
    <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="VerticalAlignment"          Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Padding"                    Value="4,0"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C7E3F7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#9DC9E5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Breadcrumb Segment Button Style ===== -->
    <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="BorderThickness"   Value="0"/>
        <Setter Property="Padding"           Value="3,1"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="FontSize"          Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C7E3F7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#9DC9E5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Context Menu Style (SC13 look) ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background"      Value="#F6F6F6"/>
        <Setter Property="BorderBrush"     Value="#CCCEDB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="1"/>
        <Setter Property="FontSize"        Value="10"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding"  Value="4,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" SharedSizeGroup="Icon"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                <ColumnDefinition Width="12"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="16" Height="16"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              Margin="4,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="#888" VerticalAlignment="Center"/>
                            <Path Grid.Column="3" x:Name="Arrow"
                                  Data="M0,0 L4,4 L0,8 Z" Fill="#505050"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right" PopupAnimation="Fade">
                                <Border Background="#F6F6F6" BorderBrush="#CCCEDB" BorderThickness="1" Padding="1">
                                    <ItemsPresenter Grid.IsSharedSizeScope="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separator -->
    <Style TargetType="Separator">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="0,2"/>
        <Setter Property="Background" Value="#CCCEDB"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" Margin="4,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
